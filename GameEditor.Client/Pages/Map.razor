@page "/map"
@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Components.Widgets
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.PathGenerators
@using Blazor.Diagrams.Core.Routers
@using Blazor.Diagrams.Options
@using GameEditor.Client.Components.MapNodes
@using GameEditor.Client.Model.Nodes
@using GameModel.Models
@using Radzen
@using Radzen.Blazor
@using Point = Blazor.Diagrams.Core.Geometry.Point
@inject IGamePackService GamePackService

<RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">

    <!-- Header / Controls -->
    <RadzenCard Style="border-radius:10px;">
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween">

            <RadzenText Text="Game Editor • Map" Style="font-weight:600; font-size:1.1rem" />

            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.End">

                <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                    <RadzenLabel Text="Cell Width (px)" />
                    <RadzenNumeric @bind-Value="CellWidth"
                                   TValue="int"
                                   Min="40" Max="800" Step="10"
                                   Style="width:120px" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                    <RadzenLabel Text="Cell Height (px)" />
                    <RadzenNumeric @bind-Value="CellHeight"
                                   TValue="int"
                                   Min="40" Max="800" Step="10"
                                   Style="width:120px" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                    <RadzenLabel Text="Level" />
                    <RadzenDropDown @bind-Value="SelectedLevel"
                                    Data="Levels"
                                    TValue="int"
                                    Style="width:140px" />
                </RadzenStack>

                <RadzenButton Icon="refresh" Text="Rebuild" ButtonStyle="ButtonStyle.Primary"
                              Click="@Rebuild" />
                <RadzenButton Icon="zoom_out_map" Text="Zoom to fit" ButtonStyle="ButtonStyle.Light"
                              Click="@ZoomToFit" />
            </RadzenStack>

        </RadzenStack>
    </RadzenCard>

    <!-- Diagram -->
    @if (Diagram is not null)
    {
        <RadzenCard Style="height:calc(100vh - 260px); border-radius:10px;">
            <CascadingValue Value="Diagram" IsFixed="true">
                <DiagramCanvas>
                    <Widgets>
                        <GridWidget Size="30" Mode="GridMode.Line" BackgroundColor="white" />
                    </Widgets>
                </DiagramCanvas>
            </CascadingValue>
        </RadzenCard>
    }

</RadzenStack>

@code {
    private BlazorDiagram Diagram = null!;
    private readonly Dictionary<string, SceneNode> _nodeMap = new();

    // Grid pixels per cell
    private int CellWidth { get; set; } = 300;
    private int CellHeight { get; set; } = 250;

    // Map level
    private int SelectedLevel { get; set; } = 0;
    private HashSet<int> Levels { get; set; } = new([0]);

    // Layout constants
    private const int NodePaddingPx = 6;
    private const int BorderCells = 1;

    protected override void OnInitialized()
    {
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = true,
            Zoom = { Enabled = true },
            Links =
      {
        DefaultRouter = new NormalRouter(),
        DefaultPathGenerator = new SmoothPathGenerator()
      }
        };

        Diagram = new BlazorDiagram(options);
        Diagram.RegisterComponent<SceneNode, SceneWidget>();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Diagram is null) return;

        var pack = GamePackService.Current;
        if (pack is null || pack.Scenes.Count == 0) return;

        Levels = pack.Scenes.Values.Select(s => s.MapLocation?.Level ?? 0).ToHashSet();
        if (!Levels.Contains(SelectedLevel))
            SelectedLevel = Levels.FirstOrDefault();

        await BuildFromGridAsync();
        Diagram.Refresh();
        Diagram.ZoomToFit();
    }

    private async Task BuildFromGridAsync()
    {
        Diagram.Links.Clear();
        Diagram.Nodes.Clear();
        _nodeMap.Clear();

        var pack = GamePackService.Current;
        if (pack is null) return;

        var scenesOnLevel = pack.Scenes.Values
          .Where(s => (s.MapLocation?.Level ?? 0) == SelectedLevel)
          .ToList();

        if (scenesOnLevel.Count == 0) return;

        int minCol = int.MaxValue, minRow = int.MaxValue;
        int maxCol = int.MinValue, maxRow = int.MinValue;

        foreach (var s in scenesOnLevel)
        {
            var m = s.MapLocation ?? new MapLocation();
            var w = Math.Max(1, m.Width);
            var h = Math.Max(1, m.Height);

            minCol = Math.Min(minCol, m.Column);
            minRow = Math.Min(minRow, m.Row);
            maxCol = Math.Max(maxCol, m.Column + (w - 1));
            maxRow = Math.Max(maxRow, m.Row + (h - 1));
        }

        var originCol = -minCol + BorderCells;
        var originRow = -minRow + BorderCells;

        foreach (var scene in scenesOnLevel)
        {
            var m = scene.MapLocation ?? new MapLocation();
            int gw = Math.Max(1, m.Width);
            int gh = Math.Max(1, m.Height);

            var px = (originCol + m.Column) * CellWidth;
            var py = (originRow + m.Row) * CellHeight;

            var node = new SceneNode(scene.Id, new Point(px, py), scene)
            {
                Title = scene.Name
            };

            Diagram.Nodes.Add(node);

            var widthPx = gw * CellWidth - NodePaddingPx;
            var heightPx = gh * CellHeight - NodePaddingPx;

            node.Size = new Size(widthPx, heightPx);
            // or: node.SetSize(new Size(widthPx, heightPx)); // if your version requires

            _nodeMap[scene.Id] = node;
            
        }

        await Task.CompletedTask;
    }

    private async Task Rebuild()
    {
        await BuildFromGridAsync();
        Diagram.Refresh();
    }

    private Task ZoomToFit()
    {
        Diagram.ZoomToFit();
        return Task.CompletedTask;
    }
}

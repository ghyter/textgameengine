

@using Blazor.Diagrams.Components.Renderers;
@using Blazor.Diagrams.Components;
@using GameEditor.Client.Components.Dialogs
@using GameEditor.Client.Model.Nodes;
@using Blazor.Diagrams.Core.Models
@using GameModel.Models
@inject DialogService DialogService;
@inject IGamePackService GamePackService;


<div class="node @(Node.Selected ? "selected":null)" >
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenText Text="@Node.Element.Name" />
            <RadzenButton Icon="edit"
                            Size="ButtonSize.Medium"
                            ButtonStyle="ButtonStyle.Primary"
                            Class="ml-2"
                            Click="@EditDialog" />
    </RadzenStack>
        @if (Node.Element is Scene scene)
    {
        <RadzenText Text="@scene.MapLocation.ToString()" Style="display:block" />
    }


    @foreach (var port in Node.Ports)
    {
        // In case you have any ports to show
        // IMPORTANT: You are always in charge of rendering ports
        <PortRenderer @key="port" Port="port" />
    }
</div>

@code {
    private GameElementNode _node = null;

    [Parameter]
    [EditorRequired]
    public GameElementNode Node { get => _node; set {
            _node = value;
            TypeKey = _node.Element.GetType() == typeof(Scene) ? "scene"
              : _node.Element.GetType() == typeof(Item) ? "item"
              : _node.Element.GetType() == typeof(Npc) ? "npc"
              : _node.Element.GetType() == typeof(Player) ? "player"
              : throw new InvalidOperationException($"Unsupported element type {_node.Element.GetType().Name}");

                TypeTitle = _node.Element.GetType() == typeof(Scene) ? "Scene"
              : _node.Element.GetType() == typeof(Item) ? "Item"
              : _node.Element.GetType() == typeof(Npc) ? "NPC"
              : _node.Element.GetType() == typeof(Player) ? "Player"
              : "Element";
    
        }}

    public IGameElement TElement => _node.Element;

    private string? TypeKey { get; set; }
    private string? TypeTitle { get; set; }



    public string SceneStyle() {

        if (Node.Element is Scene scene)
        {
            return $"width:{(Node.Size.Width * scene.MapLocation.Width)}px;height:{Node.Size.Height * scene.MapLocation.Height}px";
        }

        return string.Empty;
    }

    private async Task EditDialog()
    {
        // Logic to open the edit dialog for the GameStateNode
        // This could involve invoking a service or a dialog component
        var title = Node.Element.Name;
        Console.WriteLine($"Editing node: {Node.Element.Name}");
            // ---------- Helpers ----------
   

        await DialogService.OpenSideAsync<GameElementDialog>(
          $"Editing node: {Node.Element.Name}",
        new Dictionary<string, object?>
          {
              ["QId"] = $"{TypeKey}:{Node.Element.Id}",
              ["QMode"] = "edit"
          },
          new SideDialogOptions { Position = DialogPosition.Right, Width = "1000px", CloseDialogOnOverlayClick = false });

        // The dialog mutates GamePackService.Current directly; refresh our view.

        StateHasChanged();
    }

}

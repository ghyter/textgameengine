@using GameModel.Models
@using GameModel.Models.Enums
@using Radzen
@using Radzen.Blazor
@using System.Linq.Expressions
@inject IGamePackService GamePackService

<RadzenRow AlignItems="AlignItems.Center" Gap="0.5rem">
    <!-- Source Scene -->
    <RadzenColumn Size="4" Small="12">
        <label class="rz-label">Source</label><br/>
        <RadzenDropDown Name="SceneId"
                        TValue="string"
                        Data="@_sceneOptions"
                        TextProperty="Text"
                        ValueProperty="Value"
                        @bind-Value="Value.SceneId"
                        Style="width:100%" />
        <RadzenRequiredValidator Text="Source scene is required."
                                 Component="SceneId" Popup="false" />
    </RadzenColumn>

    <!-- Target Scene -->
    <RadzenColumn Size="4" Small="12">
        <label class="rz-label">Target</label><br/>
        <RadzenDropDown Name="TargetId"
                        TValue="string"
                        Data="@_sceneOptions"
                        TextProperty="Text"
                        ValueProperty="Value"
                        @bind-Value="Value.TargetId"
                        Style="width:100%" />
        <RadzenRequiredValidator Text="Target scene is required."
                                 Component="TargetId" Popup="false" />
    </RadzenColumn>

    <!-- Direction -->
    <RadzenColumn Size="4" Small="12">
        <label class="rz-label">Direction</label><br/>
        <RadzenDropDown Name="Direction"
                        TValue="ExitDirections"
                        TextProperty="Text"
                        ValueProperty="Value"
                        Data="@_directionOptions"
                        @bind-Value="Value.Direction"
                        Style="width:100%" />
    </RadzenColumn>
</RadzenRow>
    @if (Value.Direction == ExitDirections.Custom)
    {
        <RadzenRow>
        <RadzenColumn Size="4" Small="12">
            <label class="rz-label">Custom Dir Label</label>
            <RadzenTextBox Name="CustomDirection"
                           @bind-Value="Value.CustomDirection"
                           Style="width:100%" />
            <div style="margin-top:6px">
                <label class="rz-label">Custom Dir Id (optional)</label>
                <RadzenTextBox Name="CustomDirectionId"
                               @bind-Value="Value.CustomDirectionId"
                               Style="width:100%" />
            </div>
        </RadzenColumn>
        </RadzenRow>
    }


@code {
    [Parameter, EditorRequired] public ExitTarget Value { get; set; } = default!;
    [Parameter] public EventCallback<ExitTarget> ValueChanged { get; set; }
    [Parameter] public Expression<Func<ExitTarget>>? ValueExpression { get; set; }

    private sealed class Option { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private sealed class DirectionOption
    {
        public string Text { get; set; } = "";
        public ExitDirections Value { get; set; }
    }

    private List<Option> _sceneOptions = new(); // still for scenes
    private List<DirectionOption> _directionOptions = new(); // now for directions

    protected override void OnParametersSet()
    {
        // scenes
        var pack = GamePackService.Current;
        _sceneOptions = pack.Scenes
          .OrderBy(kv => kv.Value.Name ?? kv.Value.Id)
          .Select(kv => new Option
          {
              Text = string.IsNullOrWhiteSpace(kv.Value.Name) ? kv.Key : $"{kv.Value.Name} ({kv.Key})",
              Value = kv.Key
          })
          .ToList();

        // directions
        _directionOptions = Enum.GetValues<ExitDirections>()
            .Select(d => new DirectionOption
            {
                Text = d.ToString(),   // or use DisplayAttribute / custom mapping
                Value = d
            })
            .ToList();
    }
}
